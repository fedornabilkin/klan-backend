# Copy to Docker/.env; run from the repository root with --env-file Docker/.env -f Docker/compose.yaml
APP_ORIGIN=https://community.example.com
POSTGRES_DB=klan
POSTGRES_USER=klan
# Use the same password below. A generated hex password needs no URL encoding.
POSTGRES_PASSWORD=replace_with_random_hex_password
# Docker uses service host db, not 127.0.0.1. Encode reserved URL characters in the password.
CONTAINER_DATABASE_URL=postgresql://klan:replace_with_random_hex_password@db:5432/klan
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3001
# Used only with Docker/compose.network.yaml.
KLAN_NETWORK=klan
IMAGE_TAG=local
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_REQUIRE_GROUP_MEMBERSHIP=true
TELEGRAM_GROUP_IDS=
TELEGRAM_GROUP_LEVELS={}
TELEGRAM_MEMBERSHIP_TTL_SECONDS=60
TELEGRAM_ADMIN_IDS=
# Same 32..256 non-space ASCII secret as BOT_BACKEND_SECRET in the bot.
BOT_INTERNAL_SECRET=
