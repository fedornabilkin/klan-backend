# The installer creates /opt/klan/backend/shared/runtime.env on the server.
# Optional GitHub environment secret PRODUCTION_ENV overrides it for a release.
# Raw KEY=value: no quotes, no export, no variable interpolation, one line per value.
APP_ORIGIN=https://community.example.com
POSTGRES_DB=klan
POSTGRES_USER=klan
POSTGRES_PASSWORD=replace_with_random_hex_password
DATABASE_URL=postgresql://klan:replace_with_random_hex_password@db:5432/klan
# Set false to allow sign-in through the bot without a group membership check.
TELEGRAM_REQUIRE_GROUP_MEMBERSHIP=true
TELEGRAM_GROUP_IDS=
TELEGRAM_GROUP_LEVELS={}
TELEGRAM_MEMBERSHIP_TTL_SECONDS=60
TELEGRAM_ADMIN_IDS=
BOT_INTERNAL_SECRET=
