NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DEMO_MODE=false
DATABASE_URL=postgresql://klan:replace_with_random_password@127.0.0.1:5433/klan
# Optional local demo database: its name must be klan_demo.
# DEMO_DATABASE_URL=postgresql://klan:replace_with_random_password@127.0.0.1:5433/klan_demo
# Existing internal profile ID, not a Telegram username. Never inferred from the first profile.
DEMO_USER_ID=
DEMO_ACCESS_LEVEL=member
# Optional local demo state, ignored by Git. An absolute external path is also supported.
DEMO_DATA_FILE=.local/demo.json

# API checks group membership and sends authentication replies. The separate bot polls updates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_IDS=
TELEGRAM_GROUP_LEVELS={}
TELEGRAM_MEMBERSHIP_TTL_SECONDS=60
TELEGRAM_ADMIN_IDS=
# Same random 32..256-character secret as BOT_BACKEND_SECRET in the bot.
BOT_INTERNAL_SECRET=

# API serves a frontend bundle only if explicitly configured.
# STATIC_DIR=/srv/klan-site
